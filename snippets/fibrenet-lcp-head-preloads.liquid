{%- comment -%}
  Template-level LCP preloads in <head>. Section-level heroes (e.g. slideshow) use fibrenet-lcp-preload in the section.
  Product LCP preload: variant-first gallery image via fibrenet-lcp-preload below (matches product-media LCP candidate).
  Article LCP preload: knowledge-centre hero uses image_tag preload in sections/main-blog-post.liquid (HTTP Link header)
  Page LCP: no head preload (no global page image). Enable page LCP settings and use hero/image blocks — preload runs in section or via image_tag.
{%- endcomment -%}
{%- if template.name == 'product' and product != blank and request.params.section_id == blank -%}
  {%- liquid
    assign product_lcp_media = product.media.first
    assign product_lcp_variant_media = product.selected_or_first_available_variant.featured_media
    if product_lcp_variant_media
      assign product_lcp_media = product_lcp_variant_media
    endif
    assign product_lcp_image = product_lcp_media.preview_image
  -%}
  {%- if product_lcp_image != blank -%}
    {%- capture product_lcp_widths -%}{%- render 'fibrenet-lcp-image-dimensions', context: 'product', part: 'widths' -%}{%- endcapture -%}
    {%- capture product_lcp_sizes -%}{%- render 'fibrenet-lcp-image-dimensions', context: 'product', part: 'sizes' -%}{%- endcapture -%}
    {%- capture product_lcp_href -%}{%- render 'fibrenet-lcp-image-dimensions', context: 'product', part: 'preload_href' -%}{%- endcapture -%}
    {%- render 'fibrenet-lcp-preload',
      context: 'product',
      image: product_lcp_image,
      sizes: product_lcp_sizes,
      widths: product_lcp_widths,
      href_width: product_lcp_href
    -%}
  {%- endif -%}
{%- elsif template.name == 'blog' and blog.articles.first.image != blank -%}
  {%- capture blog_lcp_widths -%}{%- render 'fibrenet-lcp-image-dimensions', context: 'blog', part: 'widths' -%}{%- endcapture -%}
  {%- capture blog_lcp_sizes -%}{%- render 'fibrenet-lcp-image-dimensions', context: 'blog', part: 'sizes' -%}{%- endcapture -%}
  {%- capture blog_lcp_href -%}{%- render 'fibrenet-lcp-image-dimensions', context: 'blog', part: 'preload_href' -%}{%- endcapture -%}
  {%- render 'fibrenet-lcp-preload',
    context: 'blog',
    image: blog.articles.first.image,
    sizes: blog_lcp_sizes,
    widths: blog_lcp_widths,
    href_width: blog_lcp_href
  -%}
{%- elsif template.name == 'collection' -%}
  {%- liquid
    assign collection_lcp_image = collection.featured_image
    if collection_lcp_image == blank and collection.products.first != blank
      assign collection_lcp_image = collection.products.first.featured_media.preview_image
      if collection_lcp_image == blank
        assign collection_lcp_image = collection.products.first.featured_image
      endif
    endif
  -%}
  {%- if collection_lcp_image != blank -%}
    {%- capture collection_lcp_widths -%}{%- render 'fibrenet-lcp-image-dimensions', context: 'collection', part: 'widths' -%}{%- endcapture -%}
    {%- capture collection_lcp_sizes -%}{%- render 'fibrenet-lcp-image-dimensions', context: 'collection', part: 'sizes' -%}{%- endcapture -%}
    {%- capture collection_lcp_href -%}{%- render 'fibrenet-lcp-image-dimensions', context: 'collection', part: 'preload_href' -%}{%- endcapture -%}
    {%- render 'fibrenet-lcp-preload',
      context: 'collection',
      image: collection_lcp_image,
      sizes: collection_lcp_sizes,
      widths: collection_lcp_widths,
      href_width: collection_lcp_href
    -%}
  {%- endif -%}
{%- endif -%}
