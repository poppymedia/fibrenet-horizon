{%- doc -%}
  Datasheet row for Fibrenet spec table.
  On product templates that use spec.datasheet_pdf, always show this row:
  PDF link if set, else no_download_datasheet.

  @param {object} product - Product object
{%- enddoc -%}

{%- liquid
  assign spec = product.metafields.spec
  assign datasheet_metafield = spec.datasheet_pdf
  assign uses_datasheet_metafield = false
  assign datasheet_url = blank
  assign show_no_download_message = false

  if datasheet_metafield.type == 'file_reference' or datasheet_metafield.value != blank
    assign uses_datasheet_metafield = true
  endif

  if uses_datasheet_metafield == false and template.name == 'product'
    case template.suffix
      when 'cables', 'compatibles', 'cwdm', 'aocdac', 'dwdm'
        assign uses_datasheet_metafield = true
    endcase
  endif

  if uses_datasheet_metafield
    assign datasheet_file = datasheet_metafield.value

    if datasheet_file != blank and datasheet_file.url != blank
      assign file_url = datasheet_file.url | downcase
      if file_url contains '.pdf'
        assign datasheet_url = datasheet_file.url
      else
        assign show_no_download_message = true
      endif
    else
      assign show_no_download_message = true
    endif
  endif
-%}

{%- if datasheet_url != blank -%}
  <div class="product-specs-table__row" role="row">
    <span class="product-specs-table__label" role="rowheader">{{ 'products.product.spec_datasheet' | t }}</span>
    <span class="product-specs-table__leaders" aria-hidden="true"></span>
    <span class="product-specs-table__value" role="cell">
      <a href="{{ datasheet_url }}" class="link" target="_blank" rel="noopener noreferrer">
        {{ 'products.product.download_datasheet' | t }}
      </a>
    </span>
  </div>
{%- elsif show_no_download_message -%}
  <div class="product-specs-table__row" role="row">
    <span class="product-specs-table__label" role="rowheader">{{ 'products.product.spec_datasheet' | t }}</span>
    <span class="product-specs-table__leaders" aria-hidden="true"></span>
    <span class="product-specs-table__value" role="cell">{{ 'products.product.no_download_datasheet' | t }}</span>
  </div>
{%- endif -%}
