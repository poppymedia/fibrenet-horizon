{%- comment -%}
  Boots fibrenet-lazy-search.js when fn_lazy_search_active is true (page, article, or blog).
  Only rendered from layout/theme.liquid when fn_lazy_search_active is true.
{%- endcomment -%}
{%- liquid
  assign lazy_search_mode = mode | default: settings.fibrenet_lazy_search_page
-%}
<script>
  window.FibrenetLazySearch = {
    mode: {{ lazy_search_mode | json }},
    warmupDelay: 150,
    importUrls: [
      {{ 'slideshow.js' | asset_url | json }},
      {{ 'predictive-search.js' | asset_url | json }}
    ],
    moduleUrls: [
      {{ 'slideshow.js' | asset_url | json }},
      {{ 'predictive-search.js' | asset_url | json }}
    ]
  };
</script>
<script
  src="{{ 'fibrenet-lazy-search.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
