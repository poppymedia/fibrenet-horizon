{%- doc -%}
  Single row for the Fibrenet product specification table.

  @param {string} label_key - Translation key for the row heading
  @param {string} value - Cell value (row omitted when blank)
{%- enddoc -%}

{%- if value != blank -%}
  <div class="product-specs-table__row" role="row">
    <span class="product-specs-table__label" role="rowheader">{{ label_key | t }}</span>
    <span class="product-specs-table__leaders" aria-hidden="true"></span>
    <span class="product-specs-table__value" role="cell">{{ value | escape }}</span>
  </div>
{%- endif -%}
