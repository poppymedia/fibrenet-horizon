{%- doc -%}
  Simple single-column dropdown for the Fibrenet desktop header.

  @param {object} parent_link - Top-level navigation link with child links
  @param {string} id - Unique id for the list element
{%- enddoc -%}

<ul id="{{ id }}" class="submenu list-unstyled" role="list">
  {%- for child_link in parent_link.links -%}
    <li class="submenu__item">
      <a
        href="{{ child_link.url }}"
        class="submenu__link{% if child_link.active %} submenu__link--active{% endif %}"
        {% if child_link.current %}
          aria-current="page"
        {% endif %}
      >
        {{- child_link.title | escape -}}
      </a>
    </li>
  {%- endfor -%}
</ul>
