{%- comment -%}
  Fibrenet performance: template-guarded script loading.
  Import map stays complete so section-level dynamic imports still resolve.
  When merging Horizon upgrades, preserve this block and re-apply guards to new scripts.
{%- endcomment -%}
{%- liquid
  assign fn_is_product = false
  if template.name == 'product'
    assign fn_is_product = true
  endif

  assign fn_has_product_cards = false
  if fn_is_product
    assign fn_has_product_cards = true
  elsif template.name == 'index' or template.name == 'collection' or template.name == 'search' or template.name == '404'
    assign fn_has_product_cards = true
  endif

  assign fn_needs_paginated_list = false
  if template.name == 'collection' or template.name == 'search' or template.name == 'blog'
    assign fn_needs_paginated_list = true
  endif

  assign fn_has_quick_add = false
  if settings.quick_add or settings.mobile_quick_add
    assign fn_has_quick_add = true
  endif

  assign fn_needs_product_interaction = false
  if fn_is_product or fn_has_product_cards
    assign fn_needs_product_interaction = true
  endif

  assign fn_needs_quick_add_bundle = false
  if fn_has_quick_add and fn_has_product_cards
    assign fn_needs_quick_add_bundle = true
  endif

  assign fn_needs_product_media = false
  if fn_is_product or fn_needs_quick_add_bundle
    assign fn_needs_product_media = true
  endif

  assign fn_needs_collection_filters = false
  if template.name == 'collection' or template.name == 'search'
    assign fn_needs_collection_filters = true
  endif

  assign fn_needs_cart_quantity = false
  if template.name == 'cart' or fn_is_product
    assign fn_needs_cart_quantity = true
  endif

  assign fn_needs_quick_add = false
  if fn_has_quick_add and fn_has_product_cards
    assign fn_needs_quick_add = true
  endif

  assign fn_lazy_search_active = false
  assign fn_lazy_search_mode = 'off'

  if request.design_mode == false
    case template.name
      when 'page'
        if settings.fibrenet_lazy_search_page != 'off'
          assign fn_lazy_search_active = true
          assign fn_lazy_search_mode = settings.fibrenet_lazy_search_page
        endif
      when 'article'
        if settings.fibrenet_lazy_search_article != 'off'
          assign fn_lazy_search_active = true
          assign fn_lazy_search_mode = settings.fibrenet_lazy_search_article
        endif
      when 'blog'
        if settings.fibrenet_lazy_search_blog != 'off'
          assign fn_lazy_search_active = true
          assign fn_lazy_search_mode = settings.fibrenet_lazy_search_blog
        endif
    endcase
  endif

  assign fn_lazy_home_active = false
  if settings.fibrenet_lazy_home != 'off' and template.name == 'index' and request.design_mode == false
    assign fn_lazy_home_active = true
  endif

  assign fn_defer_slideshow_search = false
  if fn_lazy_search_active or fn_lazy_home_active
    assign fn_defer_slideshow_search = true
  endif

-%}

<script type="importmap">
  {
    "imports": {
      "@theme/critical": "{{ 'critical.js' | asset_url }}",
      "@theme/product-title": "{{ 'product-title-truncation.js' | asset_url }}",
      "@theme/component": "{{ 'component.js' | asset_url }}",
      "@theme/dialog": "{{ 'dialog.js' | asset_url }}",
      "@theme/events": "{{ 'events.js' | asset_url }}",
      "@theme/focus": "{{ 'focus.js' | asset_url }}",
      "@theme/morph": "{{ 'morph.js' | asset_url }}",
      "@theme/paginated-list": "{{ 'paginated-list.js' | asset_url }}",
      "@theme/performance": "{{ 'performance.js' | asset_url }}",
      "@theme/product-form": "{{ 'product-form.js' | asset_url }}",
      "@theme/recently-viewed-products": "{{ 'recently-viewed-products.js' | asset_url }}",
      "@theme/scrolling": "{{ 'scrolling.js' | asset_url }}",
      "@theme/section-renderer": "{{ 'section-renderer.js' | asset_url }}",
      "@theme/section-hydration": "{{ 'section-hydration.js' | asset_url }}",
      "@theme/utilities": "{{ 'utilities.js' | asset_url }}",
      "@theme/variant-picker": "{{ 'variant-picker.js' | asset_url }}",
      "@theme/product-title-split": "{{ 'product-title-split.js' | asset_url }}",
      "@theme/product-stock-status": "{{ 'product-stock-status.js' | asset_url }}",
      "@theme/media-gallery": "{{ 'media-gallery.js' | asset_url }}",
      "@theme/quick-add": "{{ 'quick-add.js' | asset_url }}",
      "@theme/paginated-list-aspect-ratio": "{{ 'paginated-list-aspect-ratio.js' | asset_url }}",
      "@theme/popover-polyfill": "{{ 'popover-polyfill.js' | asset_url }}"
    }
  }
</script>

{% if settings.transition_to_main_product %}
  {% # theme-check-disable ParserBlockingScript %}
  <script
    src="{{ 'view-transitions.js' | asset_url }}"
    async
    blocking="render"
  ></script>
  {% # theme-check-enable %}
{% endif %}

<link
  rel="modulepreload"
  href="{{ 'critical.js' | asset_url }}"
>

<link
  rel="modulepreload"
  href="{{ 'utilities.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'component.js' | asset_url }}"
  fetchpriority="low"
>
{% unless fn_defer_slideshow_search %}
  <link
    rel="modulepreload"
    href="{{ 'section-renderer.js' | asset_url }}"
    fetchpriority="low"
  >
  <link
    rel="modulepreload"
    href="{{ 'section-hydration.js' | asset_url }}"
    fetchpriority="low"
  >
  <link
    rel="modulepreload"
    href="{{ 'morph.js' | asset_url }}"
    fetchpriority="low"
  >
{% endunless %}

{% if fn_needs_paginated_list %}
  <link
    rel="modulepreload"
    href="{{ 'paginated-list-aspect-ratio.js' | asset_url }}"
    fetchpriority="low"
  >
  <link
    rel="modulepreload"
    href="{{ 'paginated-list.js' | asset_url }}"
    fetchpriority="low"
  >
{% endif %}

{% if fn_has_product_cards %}
  <link
    rel="modulepreload"
    href="{{ 'product-title-truncation.js' | asset_url }}"
    fetchpriority="low"
  >
{% endif %}

<link
  rel="modulepreload"
  href="{{ 'focus.js' | asset_url }}"
  fetchpriority="low"
>
{% unless fn_defer_slideshow_search %}
  <link
    rel="modulepreload"
    href="{{ 'recently-viewed-products.js' | asset_url }}"
    fetchpriority="low"
  >
  <link
    rel="modulepreload"
    href="{{ 'scrolling.js' | asset_url }}"
    fetchpriority="low"
  >
{% endunless %}
<link
  rel="modulepreload"
  href="{{ 'events.js' | asset_url }}"
  fetchpriority="low"
>
<script
  src="{{ 'popover-polyfill.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
{% if fn_needs_quick_add %}
  <script
    src="{{ 'quick-add.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}
{% if settings.show_add_discount_code %}
  <script
    src="{{ 'cart-discount.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}
<script
  src="{{ 'dialog.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
{% if fn_needs_product_interaction %}
  <script
    src="{{ 'variant-picker.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}
{% if fn_has_product_cards %}
  <script
    src="{{ 'product-card.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}
{% if fn_needs_product_interaction %}
  <script
    src="{{ 'product-form.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}
<script
  src="{{ 'accordion-custom.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'disclosure-custom.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
{% if fn_needs_product_media %}
  <script
    src="{{ 'media.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}
{% if fn_has_product_cards %}
  <script
    src="{{ 'product-price.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  <script
    src="{{ 'product-title-truncation.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}
{% if fn_is_product or fn_needs_quick_add_bundle %}
  <script
    src="{{ 'product-inventory.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}
{% if fn_needs_collection_filters %}
  <script
    src="{{ 'show-more.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}
{% unless fn_defer_slideshow_search %}
  <script
    src="{{ 'slideshow.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endunless %}
<script
  src="{{ 'anchored-popover.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'floating-panel.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
{% if fn_needs_cart_quantity %}
  <script
    src="{{ 'component-quantity-selector.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}
{% if fn_needs_product_media %}
  <script
    src="{{ 'media-gallery.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}
<script
  src="{{ 'rte-formatter.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
{% if fn_is_product %}
  <script
    src="{{ 'gift-card-recipient-form.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
  <script
    src="{{ 'localization.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% if fn_is_product %}
  <script type="module">
    import { RecentlyViewed } from '@theme/recently-viewed-products';
    RecentlyViewed.addProduct('{{ product.id }}');
  </script>
  <script
    src="{{ 'product-title-split.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  <script
    src="{{ 'product-stock-status.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% if settings.transition_to_main_product and fn_has_product_cards %}
  <script
    src="{{ 'product-card-link.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

<script
  src="{{ 'auto-close-details.js' | asset_url }}"
  defer="defer"
></script>

<script>
  const basePath = 'https://cdn.shopify.com/static/themes/horizon/placeholders';
  const Theme = {
    placeholders: {
      general: [
        `${basePath}/general-1.png`,
        `${basePath}/general-2.png`,
        `${basePath}/general-3.png`,
        `${basePath}/general-4.png`,
        `${basePath}/general-5.png`,
        `${basePath}/general-6.png`,
        `${basePath}/general-7.png`,
      ],
      product: [`${basePath}/product-ball.png`, `${basePath}/product-cone.png`, `${basePath}/product-cube.png`],
    },
    translations: {
      placeholder_image: `{{ 'content.placeholder_image' | t }}`,
      added: `{{ 'actions.added' | t }}`,
      recipient_form_fields_visible: `{{ 'content.recipient_form_fields_visible' | t }}`,
      recipient_form_fields_hidden: `{{ 'content.recipient_form_fields_hidden' | t }}`,
      recipient_form_error: `{{ 'content.recipient_form_error' | t }}`,
    },
    routes: {
      cart_add_url: '{{ routes.cart_add_url | append: '.js' }}',
      cart_change_url: '{{ routes.cart_change_url }}',
      cart_update_url: '{{ routes.cart_update_url }}',
      cart_url: '{{ routes.cart_url }}',
      predictive_search_url: '{{ routes.predictive_search_url }}',
      search_url: '{{ routes.search_url }}',
    },
    template: {
      name: '{{ template }}',
    },
  };
</script>
