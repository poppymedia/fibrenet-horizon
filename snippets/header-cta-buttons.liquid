{%- doc -%}
  Header CTA group (Chat / Call / Email). Suppresses sub-labels in the header by default.

  @param {object} cta_settings - Section or block settings with CTA fields
  @param {boolean} [show_sub_label] - When true, renders sub-label text on applicable buttons
  @param {boolean} [product_layout] - Product page: chat on top (split row), call + email equal width below
  @param {boolean} [product_page] - When true, optional product-only border overrides apply
{%- enddoc -%}

{%- liquid
  assign show_sub_label = show_sub_label | default: false
  assign product_layout = product_layout | default: false
  assign product_page = product_page | default: false

  assign chat_label = cta_settings.chat_text | default: 'Chat'
  assign call_label = cta_settings.call_text | default: 'Call'
  assign email_label = cta_settings.email_text | default: 'Email'

  assign chat_color_scheme = settings.fibrenet_cta_chat_color_scheme | default: 'scheme-3'
  assign call_color_scheme = settings.fibrenet_cta_call_color_scheme | default: 'scheme-4'
  assign email_color_scheme = settings.fibrenet_cta_email_color_scheme | default: 'scheme-5'

  assign chat_url = cta_settings.chat_link
  if chat_url == blank
    assign chat_url = '#'
  endif

  assign call_url = cta_settings.call_link
  if call_url == blank
    assign phone_digits = cta_settings.phone_number | default: shop.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', ''
    if phone_digits != blank
      assign call_url = phone_digits | prepend: 'tel:'
    endif
  else
    unless call_url contains 'tel:'
      assign call_url = call_url | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' | prepend: 'tel:'
    endunless
  endif

  assign email_url = cta_settings.email_link
  if email_url == blank and shop.email != blank
    assign email_url = shop.email | prepend: 'mailto:'
  elsif email_url != blank
    unless email_url contains 'mailto:'
      assign email_url = email_url | prepend: 'mailto:'
    endunless
  endif

  assign show_chat = false
  if cta_settings.enable_chat_cta != false
    assign show_chat = true
  endif

  assign show_call = false
  if cta_settings.enable_call_cta != false
    assign show_call = true
  endif

  assign show_email = false
  if cta_settings.enable_email_cta != false
    assign show_email = true
  endif

  assign chat_border_color = blank
  assign chat_border_hover_color = blank
  assign call_border_color = blank
  assign call_border_hover_color = blank
  assign email_border_color = blank
  assign email_border_hover_color = blank

  if product_page
    assign chat_border_color = cta_settings.chat_border_color
    assign chat_border_hover_color = cta_settings.chat_border_hover_color
    assign call_border_color = cta_settings.call_border_color
    assign call_border_hover_color = cta_settings.call_border_hover_color
    assign email_border_color = cta_settings.email_border_color
    assign email_border_hover_color = cta_settings.email_border_hover_color
  endif
-%}

<div class="header-cta-buttons{% if product_layout %} header-cta-buttons--product{% endif %}">
  {%- if product_layout -%}
    {%- if show_chat -%}
      <div class="header-cta-buttons__chat">
        {% render 'cta-button',
          button_label: chat_label,
          button_url: chat_url,
          color_scheme: chat_color_scheme,
          border_color: chat_border_color,
          border_hover_color: chat_border_hover_color,
          sub_label: cta_settings.chat_subtext,
          show_sub_label: show_sub_label,
          layout: 'split'
        %}
      </div>
    {%- endif -%}

    {%- if show_call or show_email -%}
      <div class="header-cta-buttons__pair">
        {%- if show_call -%}
          {% render 'cta-button',
            button_label: call_label,
            button_url: call_url,
            color_scheme: call_color_scheme,
            border_color: call_border_color,
            border_hover_color: call_border_hover_color,
            sub_label: cta_settings.call_subtext,
            show_sub_label: show_sub_label,
            class: 'header-cta-buttons__pair-btn'
          %}
        {%- endif -%}

        {%- if show_email -%}
          {% render 'cta-button',
            button_label: email_label,
            button_url: email_url,
            color_scheme: email_color_scheme,
            border_color: email_border_color,
            border_hover_color: email_border_hover_color,
            sub_label: cta_settings.email_subtext,
            show_sub_label: show_sub_label,
            class: 'header-cta-buttons__pair-btn'
          %}
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- else -%}
    {%- if show_chat -%}
      {% render 'cta-button',
        button_label: chat_label,
        button_url: chat_url,
        color_scheme: chat_color_scheme,
        sub_label: cta_settings.chat_subtext,
        show_sub_label: show_sub_label
      %}
    {%- endif -%}

    {%- if show_call -%}
      {% render 'cta-button',
        button_label: call_label,
        button_url: call_url,
        color_scheme: call_color_scheme,
        sub_label: cta_settings.call_subtext,
        show_sub_label: show_sub_label
      %}
    {%- endif -%}

    {%- if show_email -%}
      {% render 'cta-button',
        button_label: email_label,
        button_url: email_url,
        color_scheme: email_color_scheme,
        sub_label: cta_settings.email_subtext,
        show_sub_label: show_sub_label
      %}
    {%- endif -%}
  {%- endif -%}
</div>
