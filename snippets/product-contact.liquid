{%- doc -%}
  Contact CTA group for product pages and legacy block usage.

  @param {object} cta_settings - Settings object with CTA fields
  @param {boolean} [show_sub_label] - Show sub-labels on buttons (default true for product)
  @param {string} [layout] - When 'fibrenet', applies full-width stacked product layout
{%- enddoc -%}

{%- liquid
  if show_sub_label == nil
    assign show_sub_label = true
  endif
-%}

<div class="product-contact{% if layout == 'fibrenet' %} product-contact--stacked{% endif %}">
  {% render 'header-cta-buttons',
    cta_settings: cta_settings,
    show_sub_label: show_sub_label,
    product_layout: layout == 'fibrenet',
    product_page: layout == 'fibrenet'
  %}
  {%- if layout == 'fibrenet' and cta_settings.product_cta_helper != blank -%}
    <p class="product-contact__helper">{{ cta_settings.product_cta_helper | escape }}</p>
  {%- endif -%}
</div>
