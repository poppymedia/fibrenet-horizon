{%- liquid
  assign order = order | split: ','
  assign left = ''
  assign center = ''
  assign right = ''
  assign fibrenet_header = fibrenet_header | default: false

  if first != blank
    assign left = 'first '
  endif

  for item in order
    assign column_key = item | append: '_position'
    assign row_key = item | append: '_row'
    assign item_row = settings[row_key] | default: 'top'
    assign item_column = settings[column_key] | default: 'left'

    case item
      when 'actions'
        assign item_column = 'right'
      when 'contact', 'search', 'phone', 'localization'
        if fibrenet_header
          assign item_column = 'right'
        endif
      when 'menu'
        if fibrenet_header
          assign item_column = 'center'
        endif
      when 'logo'
        if fibrenet_header
          assign item_column = 'left'
        endif
    endcase

    if item_row == row
      case item_column
        when 'left'
          assign left = left | append: item | append: ' '
        when 'center'
          assign center = center | append: item | append: ' '
        else
          assign right = right | append: item | append: ' '
      endcase
    endif
  endfor

  assign columns = 'left,center,right' | split: ','
-%}

{%- if fibrenet_header and row == 'top' -%}
  <div class="header__utility-cluster mobile:hidden">
    {%- for item in order -%}
      {%- case item -%}
        {%- when 'localization' -%}
          {%- if localization != blank -%}{{ localization }}{%- endif -%}
        {%- when 'phone' -%}
          {%- if phone != blank -%}{{ phone }}{%- endif -%}
        {%- when 'actions' -%}
          {%- if actions != blank -%}{{ actions }}{%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
  <div class="header__mobile-cluster desktop:hidden">
    <div class="header__mobile-cluster-start">
      {%- if logo != blank -%}{{ logo }}{%- endif -%}
    </div>
    <div class="header__mobile-cluster-end">
      {%- if actions != blank -%}{{ actions }}{%- endif -%}
      {%- if first != blank -%}{{ first }}{%- endif -%}
    </div>
  </div>
{%- elsif fibrenet_header and row == 'bottom' -%}
  {%- liquid
    assign fn_left = ''
    assign fn_center = ''
    assign fn_right = ''
    for item in order
      case item
        when 'logo'
          assign fn_left = fn_left | append: 'logo '
        when 'menu'
          assign fn_center = fn_center | append: 'menu '
        when 'search', 'contact'
          assign fn_right = fn_right | append: item | append: ' '
      endcase
    endfor
  -%}
  {%- for column in columns -%}
    {%- capture items_for_column -%}
      {% case column %}
        {% when 'left' %}
          {{ fn_left }}
        {% when 'center' %}
          {{ fn_center }}
        {% else %}
          {{ fn_right }}
      {% endcase %}
    {%- endcapture -%}

    {%- assign items_array = items_for_column | strip | split: ' ' | compact -%}

    {%- if items_array.size > 0 -%}
      <div
        class="header__column header__column--{{ column }}"
        data-testid="header-{{ row }}-{{ column }}"
      >
        {%- if column == 'right' -%}
          <div class="header__main-cta-cluster">
        {%- endif -%}
        {% for key in items_array %}
          {% unless key == blank %}
            {% case key %}
              {% when 'logo' %}
                {{ logo }}
              {% when 'menu' %}
                {{ menu }}
              {% when 'search' %}
                {{ search }}
              {% when 'contact' %}
                {{ contact }}
            {% endcase %}
          {% endunless %}
        {% endfor %}
        {%- if column == 'right' -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  {%- for column in columns -%}
    {%- capture items_for_column -%}
      {% case column %}
        {% when 'left' %}
          {{ left }}
        {% when 'center' %}
          {{ center }}
        {% else %}
          {{ right }}
      {% endcase %}
    {%- endcapture -%}

    {%- assign items_array = items_for_column | strip | split: ' ' | compact -%}

    {%- if items_array.size > 0 -%}
      <div
        class="header__column header__column--{{ column }}"
        data-testid="header-{{ row }}-{{ column }}"
      >
        {% for key in items_array %}
          {% unless key == blank %}
            {% case key %}
              {% when 'first' %}
                {{ first }}
              {% when 'logo' %}
                {{ logo }}
              {% when 'menu' %}
                {{ menu }}
              {% when 'localization' %}
                {{ localization }}
              {% when 'search' %}
                {{ search }}
              {% when 'mobile_search' %}
                {{ mobile_search }}
              {% when 'actions' %}
                {{ actions }}
              {% when 'contact' %}
                {{ contact }}
              {% when 'phone' %}
                {{ phone }}
            {% endcase %}
          {% endunless %}
        {% endfor %}
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
