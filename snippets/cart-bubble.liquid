{%- doc -%}
  @param [limit] - {number}
  @param [live_region] - {boolean}

  The maximum number of items in the cart to display. If the number of items in the cart is greater than this limit, the
  count will be displayed as "99+".
{%- enddoc -%}

{%- liquid
  assign cart_bubble_scheme_id = settings.fibrenet_cart_bubble_color_scheme | default: 'scheme-1'
  if cart_bubble_scheme_id.id != blank
    assign cart_bubble_scheme_id = cart_bubble_scheme_id.id
  endif

  assign cart_bubble_bg = blank
  assign cart_bubble_text = blank

  for scheme in settings.color_schemes
    if scheme.id == cart_bubble_scheme_id
      assign cart_bubble_bg = scheme.settings.primary_button_background
      assign cart_bubble_text = scheme.settings.primary_button_text
      break
    endif
  endfor
-%}

<div
  ref="cartBubble"
  class="cart-bubble cart-bubble-scheme--{{ cart_bubble_scheme_id }}{% if cart == empty %} visually-hidden{% endif %}"
  {% if cart_bubble_bg != blank and cart_bubble_text != blank %}
    style="
      --color-cart-bubble-background: rgb({{ cart_bubble_bg.rgba }});
      --color-cart-bubble-text: rgb({{ cart_bubble_text.rgba }});
    "
  {% endif %}
  {% assign item_count = cart.item_count %}
  {% if item_count <= 99 %}
    data-maintain-ratio
  {% endif %}
>
  <span class="cart-bubble__background"></span>
  <span
    ref="cartBubbleText"
    id="cart-bubble-text"
    class="cart-bubble__text"
    {% if live_region %}
      role="status"
    {% endif %}
  >
    <span class="visually-hidden">
      {{- 'accessibility.cart_count' | t -}}
      : {{ cart.item_count }}
    </span>
    <span
      class="cart-bubble__text-count{% if cart == empty %} hidden{% endif %}"
      ref="cartBubbleCount"
      aria-hidden="true"
      data-testid="cart-bubble"
    >
      {%- if limit == blank or cart.item_count < limit %}
        {{- cart.item_count -}}
      {%- endif -%}
    </span>
  </span>
</div>
