{%- doc -%}
  Renders the blog post image block.

  @param {object} image - The image object
{%- enddoc -%}

{%- assign block_settings = block.settings -%}

{%- liquid
  assign is_blog_lcp_image = false
  if blog.articles.first != blank and image.id == blog.articles.first.image.id
    assign is_blog_lcp_image = true
  endif
-%}
{%- capture fetchpriority -%}
  {%- render 'fibrenet-lcp-fetchpriority', context: 'blog', enabled: is_blog_lcp_image -%}
{%- endcapture -%}
{%- assign fetchpriority = fetchpriority | strip -%}
{%- assign image_loading = 'lazy' -%}
{%- if is_blog_lcp_image -%}
  {%- assign image_loading = 'eager' -%}
{%- endif -%}
{%- capture blog_card_widths -%}{%- render 'fibrenet-lcp-image-dimensions', context: 'blog', part: 'widths' -%}{%- endcapture -%}
{%- capture blog_card_sizes -%}{%- render 'fibrenet-lcp-image-dimensions', context: 'blog', part: 'sizes' -%}{%- endcapture -%}
{%- capture blog_card_max -%}{%- render 'fibrenet-lcp-image-dimensions', context: 'blog', part: 'max' -%}{%- endcapture -%}
{%- capture image_border_style -%}
  {% render 'border-override', settings: block_settings %}
{%- endcapture -%}
{%- assign image_class = 'border-style blog-post-card__image blog-post-card__image--' | append: block_settings.height -%}

{{
  image
  | image_url: width: blog_card_max
  | image_tag:
    class: image_class,
    widths: blog_card_widths,
    sizes: blog_card_sizes,
    loading: image_loading,
    fetchpriority: fetchpriority,
    width: image.width,
    height: image.height,
    alt: image.alt,
    style: image_border_style
}}

{% stylesheet %}
  .blog-post-card__image {
    width: 100%;
    object-fit: cover;
    object-position: center center;
    height: calc(var(--blog-post-card-img-height) * var(--blog-post-card-scale));
  }

  .blog-post-card__image--small {
    --blog-post-card-img-height: 280px;
  }

  .blog-post-card__image--medium {
    --blog-post-card-img-height: 340px;
  }

  .blog-post-card__image--large {
    --blog-post-card-img-height: 400px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.image",
  "blocks": [],
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.border",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "px",
      "label": "t:settings.border_width",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.border_opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
