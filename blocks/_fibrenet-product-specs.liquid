{%- liquid
  assign product = closest.product
  assign spec = product.metafields.spec
  assign public_sku = product.metafields.data.public_sku.value | default: ''
-%}

{%- capture spec_rows -%}
  {% render 'fibrenet-spec-row', label_key: 'products.product.spec_fibre_type', value: spec.fibre_type.value %}
  {% render 'fibrenet-spec-row', label_key: 'products.product.spec_fibre_count', value: spec.fibre_count.value %}
  {% render 'fibrenet-spec-row', label_key: 'products.product.spec_glass_fibre', value: spec.glass_fibre.value %}
  {% render 'fibrenet-spec-row', label_key: 'products.product.spec_insertion_loss', value: spec.insertion_loss.value %}
  {% render 'fibrenet-spec-row', label_key: 'products.product.spec_cable_diameter', value: spec.cable_diameter.value %}
  {% render 'fibrenet-spec-row', label_key: 'products.product.spec_fibre_grade', value: spec.fibre_grade.value %}
  {% render 'fibrenet-spec-row', label_key: 'products.product.spec_cable_jacket', value: spec.cable_jacket.value %}
  {% render 'fibrenet-spec-row', label_key: 'products.product.spec_fibre_color', value: spec.fibre_color.value %}
  {% render 'fibrenet-spec-row', label_key: 'products.product.spec_minimum_bend_radius', value: spec.minimum_bend_radius.value %}
  {% render 'fibrenet-spec-row', label_key: 'products.product.spec_polarity', value: spec.polarity.value %}
  {% render 'fibrenet-spec-row', label_key: 'products.product.spec_format', value: spec.format.value %}
  {% render 'fibrenet-spec-row', label_key: 'products.product.spec_connector', value: spec.connector.value %}
  {% render 'fibrenet-spec-row', label_key: 'products.product.spec_wavelength', value: spec.wavelength.value %}
  {% render 'fibrenet-spec-row', label_key: 'products.product.spec_distance', value: spec.distance.value %}
  {% render 'fibrenet-spec-row', label_key: 'products.product.spec_datarate', value: spec.datarate.value %}
  {% render 'fibrenet-spec-row', label_key: 'products.product.spec_fn_sku', value: public_sku %}
  {% render 'fibrenet-product-spec-datasheet', product: product %}
{%- endcapture -%}

{%- liquid
  assign spec_rows_stripped = spec_rows | strip
-%}
{%- if spec_rows_stripped != blank -%}
  <div class="product-specs-table" {{ block.shopify_attributes }}>
    <div class="product-specs-table__table" role="table">
      <div class="product-specs-table__body" role="rowgroup">
        {{ spec_rows }}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Specification table",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Rows render from product metafields in the spec namespace, data.public_sku, and datasheet. On templates that use spec.datasheet_pdf, the datasheet row always appears (PDF link or no-download message)."
    }
  ]
}
{% endschema %}
