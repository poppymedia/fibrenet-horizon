{% render 'product-contact', cta_settings: block.settings, show_sub_label: true, layout: 'fibrenet' %}

{% schema %}
{
  "name": "Product contact CTAs",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Chat"
    },
    {
      "type": "checkbox",
      "id": "enable_chat_cta",
      "label": "Show Chat button",
      "default": true
    },
    {
      "type": "text",
      "id": "chat_text",
      "label": "Chat label",
      "default": "Chat"
    },
    {
      "type": "text",
      "id": "chat_subtext",
      "label": "Chat sub-label",
      "default": "For bulk orders chat with UK team now for savings"
    },
    {
      "type": "url",
      "id": "chat_link",
      "label": "Chat URL"
    },
    {
      "type": "header",
      "content": "Call"
    },
    {
      "type": "checkbox",
      "id": "enable_call_cta",
      "label": "Show Call button",
      "default": true
    },
    {
      "type": "text",
      "id": "call_text",
      "label": "Call label",
      "default": "Call"
    },
    {
      "type": "text",
      "id": "call_subtext",
      "label": "Call sub-label"
    },
    {
      "type": "url",
      "id": "call_link",
      "label": "Call URL"
    },
    {
      "type": "header",
      "content": "Email"
    },
    {
      "type": "checkbox",
      "id": "enable_email_cta",
      "label": "Show Email button",
      "default": true
    },
    {
      "type": "text",
      "id": "email_text",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email_subtext",
      "label": "Email sub-label"
    },
    {
      "type": "url",
      "id": "email_link",
      "label": "Email URL"
    },
    {
      "type": "header",
      "content": "Button borders (product page)"
    },
    {
      "type": "paragraph",
      "content": "Optional. Leave blank to use the same primary button borders as the header. Button fill and text colours are set under Theme settings → Contact CTA buttons."
    },
    {
      "type": "color",
      "id": "chat_border_color",
      "label": "Chat border",
      "alpha": true
    },
    {
      "type": "color",
      "id": "chat_border_hover_color",
      "label": "Chat border (hover)",
      "alpha": true
    },
    {
      "type": "color",
      "id": "call_border_color",
      "label": "Call border",
      "alpha": true
    },
    {
      "type": "color",
      "id": "call_border_hover_color",
      "label": "Call border (hover)",
      "alpha": true
    },
    {
      "type": "color",
      "id": "email_border_color",
      "label": "Email border",
      "alpha": true
    },
    {
      "type": "color",
      "id": "email_border_hover_color",
      "label": "Email border (hover)",
      "alpha": true
    },
    {
      "type": "header",
      "content": "Helper text"
    },
    {
      "type": "text",
      "id": "product_cta_helper",
      "label": "Text below buttons",
      "default": "For even better potential pricing, contact UK office now"
    }
  ]
}
{% endschema %}
