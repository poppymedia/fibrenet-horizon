{% liquid
  assign block_settings = block.settings
  assign block_index = 0
  for section_block in section.blocks
    if section_block.id == block.id
      assign block_index = forloop.index0
      break
    endif
  endfor
  assign section_index = section.index
  assign use_responsive_image = false
  if section.settings.background_image_style == 'responsive_image'
    assign use_responsive_image = true
  endif

  assign bg_image = blank
  assign slide_bg_url = blank
  if block_settings.image != blank
    assign bg_image = block_settings.image | image_url: width: 1400
    assign slide_bg_url = block_settings.image | image_url: width: 1000
  elsif block_settings.image_url_fallback != blank
    assign bg_image = block_settings.image_url_fallback
    assign slide_bg_url = block_settings.image_url_fallback
  endif
%}

{% liquid
  assign content_alignment = block_settings.content_alignment | default: 'center'
  assign content_width = block_settings.content_width | default: 'full'
  assign slide_class = 'hero-slide hero-slide--align-' | append: content_alignment
  if content_width == 'half'
    assign slide_class = slide_class | append: ' hero-slide--half'
  endif
  if block_settings.show_overlay
    assign slide_class = slide_class | append: ' hero-slide--overlay'
  endif
  if use_responsive_image
    assign slide_class = slide_class | append: ' hero-slide--responsive-image'
  endif
%}

{% liquid
  assign is_lcp_slide = false
%}
{% capture lcp_context %}
  {% render 'fibrenet-lcp-resolve', section_index: section_index, block_index: block_index %}
{% endcapture %}
{% liquid
  assign lcp_context = lcp_context | strip
  if lcp_context != 'none'
    assign is_lcp_slide = true
  endif
%}

{% liquid
  assign show_slide_bg = false
  if slide_bg_url != blank
    if use_responsive_image == false or block_index > 0
      assign show_slide_bg = true
    endif
  endif
%}

{% capture children %}
  <div
    class="slide__image-container hero-slide__media{% if use_responsive_image %} hero-slide__media--img{% endif %}"
    {%- if show_slide_bg -%}
      style="background-image: url('{{ slide_bg_url | escape }}');"
    {%- elsif use_responsive_image == false and bg_image != blank -%}
      style="background-image: url('{{ bg_image | escape }}');"
    {%- endif -%}
  >
    {%- if use_responsive_image -%}
      {%- if block_settings.image != blank -%}
        {%- liquid
          assign height = block_settings.image.width | divided_by: block_settings.image.aspect_ratio | round
          assign sizes = '100vw'
          assign loading = 'eager'
          assign hero_http_preload = false
          if is_lcp_slide
            assign preload_key = 'fibrenet_lcp_preload_' | append: lcp_context
            if settings[preload_key]
              assign hero_http_preload = true
            endif
          endif
        -%}
        {%- capture hero_image_widths -%}{%- render 'fibrenet-hero-image-widths' -%}{%- endcapture -%}
        {%- capture hero_image_max -%}{%- render 'fibrenet-hero-image-max' -%}{%- endcapture -%}
        {%- liquid
          assign widths = hero_image_widths | strip
          assign hero_image_max_width = hero_image_max | strip | plus: 0
        -%}
        {%- capture fetchpriority -%}
          {%- render 'fibrenet-lcp-fetchpriority', context: lcp_context, enabled: is_lcp_slide -%}
        {%- endcapture -%}
        {%- assign fetchpriority = fetchpriority | strip -%}
        {{
          block_settings.image
          | image_url: width: hero_image_max_width
          | image_tag:
            height: height,
            sizes: sizes,
            widths: widths,
            class: 'slide__image',
            loading: loading,
            fetchpriority: fetchpriority,
            preload: hero_http_preload,
            alt: ''
        }}
      {%- elsif block_settings.image_url_fallback != blank -%}
        {%- liquid
          assign loading = 'eager'
        -%}
        {%- capture fetchpriority -%}
          {%- render 'fibrenet-lcp-fetchpriority', context: lcp_context, enabled: is_lcp_slide -%}
        {%- endcapture -%}
        {%- assign fetchpriority = fetchpriority | strip -%}
        <img
          src="{{ block_settings.image_url_fallback | escape }}"
          class="slide__image"
          alt=""
          loading="{{ loading }}"
          fetchpriority="{{ fetchpriority }}"
          width="1000"
          height="355"
        >
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'slide__image' }}
      {%- endif -%}
      {%- if block_settings.show_overlay -%}
        <span class="hero-slide__overlay" style="--hero-overlay-opacity: {{ block_settings.overlay_opacity | default: 50 }};" aria-hidden="true"></span>
      {%- endif -%}
    {%- else -%}
      {%- if bg_image == blank -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'slide__image' }}
      {%- endif -%}
      {%- if block_settings.show_overlay -%}
        <span class="hero-slide__overlay" style="--hero-overlay-opacity: {{ block_settings.overlay_opacity | default: 50 }};" aria-hidden="true"></span>
      {%- endif -%}
    {%- endif -%}
  </div>
  <div
    class="slide__content background-transparent hero-slide__content hero-slide__content--{{ content_alignment }}"
    {{ block.shopify_attributes }}
  >
    <div
      class="layout-panel-flex layout-panel-flex--column hero-slide__text{% if content_width == 'half' %} hero-slide__text--half{% endif %}"
      style="--horizontal-alignment: flex-start; --vertical-alignment: center;"
    >
      {%- if block_settings.heading != blank -%}
        <h2 class="hero-slide__heading">{{ block_settings.heading | escape | newline_to_br }}</h2>
      {%- endif -%}
      {%- if block_settings.subheading != blank -%}
        <p class="hero-slide__subheading">{{ block_settings.subheading | escape | newline_to_br }}</p>
      {%- endif -%}
      {% content_for 'blocks' %}
    </div>
  </div>
{% endcapture %}

{% render 'slideshow-slide',
  index: block_index,
  class: slide_class,
  children: children,
  attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Fibrenet slide",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "url",
      "id": "image_url_fallback",
      "label": "Background image URL (fallback)"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show image overlay",
      "default": false
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ block.settings.show_overlay }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        { "value": "full", "label": "Full" },
        { "value": "half", "label": "Half" }
      ],
      "default": "full"
    },
    {
      "type": "paragraph",
      "content": "Add text and button blocks for the heading, description, and call to action. The heading and subheading below are kept for older slides."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    }
  ],
  "presets": [
    {
      "name": "Fibrenet slide"
    }
  ]
}
{% endschema %}
