{%- liquid
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant
  assign stock_protect = section.settings.fibrenet_stock_protect

  assign stock_lead_time_entries = ''
  if product.metafields.custom.lead_time.value.entries != blank
    assign stock_lead_time_entries = product.metafields.custom.lead_time.value.entries
  endif

  assign inventory_managed = false
  if variant.inventory_management == 'shopify'
    assign inventory_managed = true
  endif

  assign stock_message_type = 'in_stock_untracked'
  assign stock_count = 0

  if inventory_managed or stock_lead_time_entries != blank
    if stock_lead_time_entries != blank
      assign stock_message_type = 'lead_time'
    elsif inventory_managed
      assign stock_count = variant.inventory_quantity | default: 0
      if stock_count > 0
        assign stock_message_type = 'quantity'
      else
        assign stock_message_type = 'sold_out'
      endif
    else
      assign stock_message_type = 'in_stock_untracked'
    endif
  else
    assign stock_message_type = 'in_stock_untracked'
  endif

  assign stock_label_html_template = 'products.product.stock_label_fibrenet_html' | t: count: 0 | replace: '0', '__COUNT__'
-%}

{%- capture variants_inventory -%}
  {
  {%- for v in product.variants -%}
    "{{ v.id }}": {
      "quantity": {{ v.inventory_quantity | default: 0 }},
      "managed": {% if v.inventory_management == 'shopify' %}true{% else %}false{% endif %},
      "available": {{ v.available | json }}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
  }
{%- endcapture -%}

<fibrenet-product-stock
  class="fibrenet-product-stock product-inventory spacing-style"
  {{ block.shopify_attributes }}
  data-stock-protect="{{ stock_protect }}"
  data-product-id="{{ product.id }}"
  data-lead-time="{{ stock_lead_time_entries | escape }}"
  data-in-stock-label="{{ 'products.product.in_stock_label' | t | escape }}"
  data-lead-time-label="{{ 'products.product.lead_time_label' | t | escape }}"
  data-sold-out-html="{{ 'products.product.sold_out_fibrenet_html' | t | escape }}"
  data-stock-label-template="{{ stock_label_html_template | escape }}"
>
  <span class="fibrenet-product-stock__status product-inventory__status" role="status">
    <span class="fibrenet-product-stock__text product-inventory__text" data-fibrenet-stock-text>
      {%- case stock_message_type -%}
        {%- when 'quantity' -%}
          {{ 'products.product.stock_label_fibrenet_html' | t: count: stock_count }}
        {%- when 'lead_time' -%}
          {{ 'products.product.lead_time_label' | t }}<strong>{{ stock_lead_time_entries | escape }}</strong>
        {%- when 'sold_out' -%}
          {{ 'products.product.sold_out_fibrenet_html' | t }}
        {%- else -%}
          {{ 'products.product.in_stock_label' | t }}
      {%- endcase -%}
    </span>
  </span>

  <script type="application/json" data-fibrenet-stock-variants>
    {{ variants_inventory }}
  </script>
</fibrenet-product-stock>

{% stylesheet %}
  .fibrenet-product-stock__status {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    font-size: var(--fibrenet-type-min-size, 0.875rem);
    line-height: var(--font-paragraph--line-height);
  }

  .fibrenet-product-stock__text {
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fibrenet stock",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Fibrenet inventory messaging with lead-time override. Replaces default product inventory on alternate product templates."
    }
  ]
}
{% endschema %}
