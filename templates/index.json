{
  "sections": {
    "fibrenet_slideshow": {
      "type": "fibrenet-slideshow",
      "blocks": {
        "slide_1": {
          "type": "fibrenet-slide",
          "settings": {
            "heading": "Tested, evaluated, approved",
            "subheading": "and used by the largest service providers in the world",
            "image_url_fallback": "https://cdn.shopify.com/s/files/1/0907/5464/6391/files/Flare_1_resized_1000x355_JPG.jpg?v=1777381124"
          }
        },
        "slide_2": {
          "type": "fibrenet-slide",
          "settings": {
            "heading": "95% of orders shipped same day from UK stock",
            "subheading": "with tracked UPS overnight delivery",
            "image_url_fallback": "https://cdn.shopify.com/s/files/1/0907/5464/6391/files/Flare_2_resized_and_flipped_1000x355_PNG.png?v=1777381144"
          }
        },
        "slide_3": {
          "type": "fibrenet-slide",
          "settings": {
            "heading": "Guaranteed compatibility for all network vendors",
            "subheading": "We constantly research and provide the latest vendor coding",
            "image_url_fallback": "https://cdn.shopify.com/s/files/1/0907/5464/6391/files/Flare_3_resized_1000x355_JPG.jpg?v=1777381162"
          }
        },
        "slide_4": {
          "type": "fibrenet-slide",
          "settings": {
            "heading": "Minimum 5 year warranty on all Fibrenet products",
            "subheading": "with advance replacement as standard",
            "image_url_fallback": "https://cdn.shopify.com/s/files/1/0907/5464/6391/files/Flare_4_resized_1000x355_JPG.jpg?v=1777381165"
          }
        }
      },
      "block_order": ["slide_1", "slide_2", "slide_3", "slide_4"],
      "settings": {
        "auto_rotate": true,
        "change_slides_speed": 5,
        "show_arrows": true,
        "icons_style": "arrows_large",
        "slideshow_controls_style": "dots",
        "slide_height_desktop": 250,
        "slide_height_mobile": "auto",
        "color_scheme": "scheme-6",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "partner_bar": {
      "type": "partner-bar",
      "blocks": {
        "logo_cisco": { "type": "logo", "settings": { "alt_text": "Cisco" } },
