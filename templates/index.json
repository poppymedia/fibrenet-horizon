        "logo_ciena": { "type": "logo", "settings": { "alt_text": "Ciena" } },
        "logo_huawei": { "type": "logo", "settings": { "alt_text": "Huawei" } },
        "logo_hp": { "type": "logo", "settings": { "alt_text": "HP" } },
        "logo_aruba": { "type": "logo", "settings": { "alt_text": "Aruba" } },
        "logo_h3c": { "type": "logo", "settings": { "alt_text": "H3C" } },
        "logo_extreme": { "type": "logo", "settings": { "alt_text": "Extreme" } },
        "logo_brocade": { "type": "logo", "settings": { "alt_text": "Brocade" } },
        "logo_nokia": { "type": "logo", "settings": { "alt_text": "Nokia" } },
        "logo_calix": { "type": "logo", "settings": { "alt_text": "Calix" } },
