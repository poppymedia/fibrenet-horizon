{% liquid
  assign is_knowledge_centre = false
  if section.settings.layout_style == 'knowledge_centre'
    assign is_knowledge_centre = true
  endif
%}

{%- if section.settings.show_blog_tag_nav -%}
  {% render 'blog-tag-filter', blog: blog, article: article, show_all_tab: true %}
{%- endif -%}

{%- if is_knowledge_centre -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="section blog-posts--knowledge-centre article-editorial color-{{ section.settings.color_scheme }} spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="article-editorial__inner">
      {%- content_for 'block', id: 'blog-post-title', type: 'text' -%}

      {%- if article.tags.size > 0 -%}
        <p class="article-editorial__tags">{{ article.tags | join: ' · ' | escape }}</p>
      {%- endif -%}

      {%- if article.image -%}
        {%- liquid
          assign hero_alt = article.image.alt | default: article.title
          assign article_http_preload = false
          if settings.fibrenet_lcp_preload_article and request.params.section_id == blank
            assign article_http_preload = true
          endif
        -%}
        {%- capture article_lcp_widths -%}{%- render 'fibrenet-lcp-image-dimensions', context: 'article', part: 'widths' -%}{%- endcapture -%}
        {%- capture article_lcp_sizes -%}{%- render 'fibrenet-lcp-image-dimensions', context: 'article', part: 'sizes' -%}{%- endcapture -%}
        {%- capture article_lcp_max -%}{%- render 'fibrenet-lcp-image-dimensions', context: 'article', part: 'max' -%}{%- endcapture -%}
        <div class="article-editorial__hero">
          {%- capture fetchpriority -%}
            {%- render 'fibrenet-lcp-fetchpriority', context: 'article', enabled: true -%}
          {%- endcapture -%}
          {%- assign fetchpriority = fetchpriority | strip -%}
          {{
            article.image
            | image_url: width: article_lcp_max
            | image_tag:
              class: 'article-editorial__hero-img',
              loading: 'eager',
              widths: article_lcp_widths,
              sizes: article_lcp_sizes,
              fetchpriority: fetchpriority,
              preload: article_http_preload,
              alt: hero_alt
          }}
        </div>
      {%- endif -%}

      {%- liquid
        assign article_body = article.content
        assign article_lead = blank
        assign lead_parts = article.content | split: '</p>'
        if lead_parts.size > 1 and lead_parts[0] contains '<p'
          assign article_lead = lead_parts[0] | append: '</p>'
          assign article_body = lead_parts | slice: 1, lead_parts.size | join: '</p>'
        endif
      -%}

      {%- if article_lead != blank -%}
        <div class="article-editorial__lead rte">
          {{ article_lead }}
        </div>
      {%- endif -%}

      {% render 'fibrenet-article-metafields', article: article %}

      <div class="article-editorial__content rte">
        {%- if article_lead != blank -%}
          {{ article_body }}
        {%- else -%}
          {{ article.content }}
        {%- endif -%}
      </div>

      {% render 'fibrenet-article-navigation',
        blog: blog,
        back_label: section.settings.back_label,
        knowledge_centre_label: section.settings.knowledge_centre_label
      %}
    </div>

    {%- if blog.comments_enabled? -%}
      <div class="article-editorial__comments blog-post-comments-container">
        <h2 class="h3">{{- 'blogs.article.comments_heading' | t: count: article.comments_count -}}</h2>

        <div class="blog-post-comments">
          {% paginate article.comments by 10 %}
            {% for comment in article.comments %}
              <div class="blog-post-comment">
                {{ comment.content }}
                <div class="blog-post-comment__author">
                  <span class="blog-post-comment__author-name">{{- comment.author -}}</span>
                  <span>{{- 'blogs.article.comment_author_separator' | t -}}</span>
                  <span class="blog-post-comment__date">
                    {{- comment.created_at | time_tag: format: 'date' -}}
                  </span>
                </div>
              </div>
            {% endfor %}

            <div class="blog-post-comments-pagination">
              {{- paginate | default_pagination -}}
            </div>
          {% endpaginate %}
        </div>

        {% render 'blog-comment-form', article: article, section_id: section.id %}
      </div>
    {%- endif -%}
  </div>
{%- else -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div class="section color-{{ section.settings.color_scheme }}">
    <div
      class="
        spacing-style
        layout-panel-flex
        layout-panel-flex--column
        section-content-wrapper
        mobile-column
      "
      style="
        {% render 'layout-panel-style', settings: section.settings %}
        {% render 'spacing-style', settings: section.settings %}
      "
    >
      <header>
        {%- content_for 'block', id: 'blog-post-title', type: 'text' %}
        {%- content_for 'block', id: 'blog-post-details', type: '_blog-post-info-text' %}
      </header>

      {%- if article.image -%}
        {%- content_for 'block', id: 'blog-post-image', type: '_blog-post-featured-image' %}
      {%- endif -%}
      {%- content_for 'block', id: 'blog-post-content', type: '_blog-post-content' %}

      {% if blog.comments_enabled? %}
        <div class="blog-post-comments-container">
          <h2 class="h3">{{- 'blogs.article.comments_heading' | t: count: article.comments_count -}}</h2>

          <div class="blog-post-comments">
            {% paginate article.comments by 10 %}
              {% for comment in article.comments %}
                <div class="blog-post-comment">
                  {{ comment.content }}
                  <div class="blog-post-comment__author">
                    <span class="blog-post-comment__author-name">{{- comment.author -}}</span>
                    <span>{{- 'blogs.article.comment_author_separator' | t -}}</span>
                    <span class="blog-post-comment__date">
                      {{- comment.created_at | time_tag: format: 'date' -}}
                    </span>
                  </div>
                </div>
              {% endfor %}

              <div class="blog-post-comments-pagination">
                {{- paginate | default_pagination -}}
              </div>
            {% endpaginate %}
          </div>

          {% render 'blog-comment-form', article: article, section_id: section.id %}
        </div>
      {% endif %}
    </div>
  </div>
{%- endif -%}

{% content_for 'blocks' %}

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% stylesheet %}
  .blog-post-comments-container {
    width: 100%;
    margin: 0 auto;
  }

  .article-editorial .blog-post-comments-container {
    max-width: none;
    margin-inline: 0;
    padding-inline: 40px;
    padding-block-end: 48px;
  }

  @media screen and (min-width: 750px) {
    .article-editorial .blog-post-comments-container {
      width: 100%;
      max-width: var(--editorial-width, 60%);
      margin-inline: auto;
    }
  }


  .blog-post-comments {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xl);
  }

  .blog-post-comment__author {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    margin-top: var(--margin-md);
    font-size: var(--font-size--body-sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .blog-post-comments-pagination {
    display: flex;
    justify-content: center;
    gap: var(--gap-2xs);
  }

  .blog-post-comments-pagination,
  .blog-post-comments-pagination a {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a {
    display: block;
    padding: var(--padding-2xs) var(--padding-xs);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a:hover {
    border-bottom: 1px solid var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_post",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "class": "section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout",
      "options": [
        {
          "value": "editorial",
          "label": "Editorial (default)"
        },
        {
          "value": "knowledge_centre",
          "label": "Knowledge Centre article"
        }
      ],
      "default": "editorial"
    },
    {
      "type": "checkbox",
      "id": "show_blog_tag_nav",
      "label": "Show blog tag navigation",
      "default": true
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back link label",
      "default": "← Back",
      "visible_if": "{{ section.settings.layout_style == 'knowledge_centre' }}"
    },
    {
      "type": "text",
      "id": "knowledge_centre_label",
      "label": "Knowledge Centre button label",
      "default": "→ Back to Knowledge Centre",
      "visible_if": "{{ section.settings.layout_style == 'knowledge_centre' }}"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
