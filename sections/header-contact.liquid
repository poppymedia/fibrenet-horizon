{%- liquid
  assign section_settings = section.settings
-%}

<div class="header-contact-wrapper" {{ section.shopify_attributes }}>
  {% render 'product-contact', cta_settings: section_settings %}
</div>

{% stylesheet %}
.header-contact-wrapper {
  display: flex;
  align-items: center;
  height: 100%;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Contact Button",
  "class": "header-contact",
  "settings": [
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "row",
      "label": "Row",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "top"
    }
  ]
}
{% endschema %}