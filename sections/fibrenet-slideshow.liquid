{%- assign first_block = section.blocks.first -%}
{%- if section.settings.background_image_style == 'responsive_image' and section.index == 1 and first_block != blank -%}
  {%- if first_block.settings.image != blank -%}
    {%- assign lcp_image = first_block.settings.image -%}
    <link
      rel="preload"
      as="image"
      href="{{ lcp_image | image_url: width: 1000 }}"
      imagesrcset="
        {{ lcp_image | image_url: width: 750 }} 750w,
        {{ lcp_image | image_url: width: 1000 }} 1000w,
        {{ lcp_image | image_url: width: 1200 }} 1200w,
        {{ lcp_image | image_url: width: 1400 }} 1400w
      "
      imagesizes="100vw"
      fetchpriority="high"
    >
  {%- elsif first_block.settings.image_url_fallback != blank -%}
    <link
      rel="preload"
      as="image"
      href="{{ first_block.settings.image_url_fallback | escape }}"
      fetchpriority="high"
    >
  {%- endif -%}
{%- endif -%}

{% liquid
  assign autoplay_seconds = section.settings.change_slides_speed
  if autoplay_seconds == blank or autoplay_seconds < 1
    assign autoplay_seconds = 5
  endif

  assign slide_height_mobile = section.settings.slide_height_mobile
  if slide_height_mobile == 'auto'
    assign slide_height_mobile_value = 'auto'
  else
    assign slide_height_mobile_value = slide_height_mobile | append: 'px'
  endif
%}

{% if section.blocks.size > 1 %}
  {% capture controls %}
    {%- render 'slideshow-controls',
      style: section.settings.slideshow_controls_style,
      autoplay: section.settings.auto_rotate,
      item_count: section.blocks.size,
      show_arrows: false,
      arrows_on_media: true,
      controls_on_media: true,
      pagination_position: 'center',
      icon_style: section.settings.icons_style
    -%}
  {% endcapture %}
{% endif %}

{% capture slides %}
  {% content_for 'blocks' %}
{% endcapture %}

{% liquid
  assign slideshow_class = 'slideshow--single-media'
  if section.blocks.size > 1
    assign slideshow_class = ''
  endif

  assign show_arrows = section.settings.show_arrows
  if section.settings.icons_style == 'none' or section.blocks.size <= 1
    assign show_arrows = false
  endif

  assign hero_slideshow_classes = 'hero-slideshow spacing-style section section--' | append: section.settings.section_width | append: ' color-' | append: section.settings.color_scheme | append: ' disable-section-top-offset'

  if section.settings.background_image_style == 'responsive_image'
    assign hero_slideshow_classes = hero_slideshow_classes | append: ' hero-slideshow--responsive-images'
  endif

  if slide_height_mobile != 'auto'
    assign hero_slideshow_classes = hero_slideshow_classes | append: ' hero-slideshow--mobile-height-fixed'
  endif

  assign hero_aspect_ratio = blank
  if section.settings.background_image_style == 'responsive_image' and slide_height_mobile == 'auto'
    assign hero_first_block = section.blocks.first
    if hero_first_block.settings.image != blank
      assign hero_aspect_ratio = hero_first_block.settings.image.aspect_ratio
    endif
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="{{ hero_slideshow_classes }}"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    --slideshow-height-desktop: {{ section.settings.slide_height_desktop }}px;
    --slideshow-height-mobile: {{ slide_height_mobile_value }};
    {%- if hero_aspect_ratio != blank -%}
      --hero-slide-aspect-ratio: {{ hero_aspect_ratio }};
    {%- endif -%}
  "
>
  {% render 'slideshow',
    class: slideshow_class,
    controls: controls,
    show_arrows: show_arrows,
    icon_style: section.settings.icons_style,
    autoplay: section.settings.auto_rotate,
    autoplay_speed: autoplay_seconds,
    slides: slides,
    slide_count: section.blocks.size,
    slide_size: 'auto'
  %}
</div>

{% javascript %}
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const pauseFibrenetSlideshows = () => {
    document.querySelectorAll('.hero-slideshow slideshow-component[autoplay]').forEach((slideshow) => {
      if (typeof slideshow.pause === 'function') slideshow.pause();
    });
  };

  if (prefersReducedMotion.matches) pauseFibrenetSlideshows();
  prefersReducedMotion.addEventListener('change', (event) => {
    if (event.matches) pauseFibrenetSlideshows();
  });
{% endjavascript %}

{% schema %}
{
  "name": "Fibrenet slideshow",
  "class": "container-background-image",
  "blocks": [
    {
      "type": "fibrenet-slide"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "label": "Change slides every",
      "min": 3,
      "max": 9,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.auto_rotate }}"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show previous/next arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "Arrow style",
      "options": [
        {
          "value": "arrow",
          "label": "Arrows"
        },
        {
          "value": "chevron",
          "label": "Chevrons"
        },
        {
          "value": "arrows_large",
          "label": "Large arrows"
        },
        {
          "value": "chevron_large",
          "label": "Large chevrons"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "arrows_large"
    },
    {
      "type": "select",
      "id": "slideshow_controls_style",
      "label": "Pagination",
      "options": [
        {
          "value": "hidden",
          "label": "Hidden"
        },
        {
          "value": "dots",
          "label": "Dots"
        },
        {
          "value": "counter",
          "label": "Counter"
        }
      ],
      "default": "dots"
    },
    {
      "type": "range",
      "id": "slide_height_desktop",
      "label": "Slide height (desktop)",
      "min": 180,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 250
    },
    {
      "type": "select",
      "id": "slide_height_mobile",
      "label": "Slide height (mobile)",
      "options": [
        {
          "value": "auto",
          "label": "Auto (image aspect ratio)"
        },
        {
          "value": "180",
          "label": "180px"
        },
        {
          "value": "220",
          "label": "220px"
        },
        {
          "value": "250",
          "label": "250px"
        }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "background_image_style",
      "label": "Background image delivery",
      "options": [
        {
          "value": "css_background",
          "label": "CSS background"
        },
        {
          "value": "responsive_image",
          "label": "Responsive image (performance)"
        }
      ],
      "default": "css_background",
      "info": "Responsive image uses an <img> tag so browsers can prioritise the first slide for faster loading (LCP). Upload images via the image picker for best results."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Fibrenet slideshow",
      "category": "Fibrenet",
      "settings": {
        "auto_rotate": true,
        "change_slides_speed": 5,
        "slide_height_desktop": 250,
        "slide_height_mobile": "auto",
        "section_width": "full-width",
        "show_arrows": true,
        "icons_style": "arrows_large"
      },
      "blocks": {
        "slide_1": {
          "type": "fibrenet-slide",
          "settings": {
            "heading": "Tested, evaluated, approved",
            "subheading": "and used by the largest service providers in the world",
            "image_url_fallback": "https://cdn.shopify.com/s/files/1/0907/5464/6391/files/Flare_1_resized_1000x355_JPG.jpg?v=1777381124"
          }
        },
        "slide_2": {
          "type": "fibrenet-slide",
          "settings": {
            "heading": "95% of orders shipped same day from UK stock",
            "subheading": "with tracked UPS overnight delivery",
            "image_url_fallback": "https://cdn.shopify.com/s/files/1/0907/5464/6391/files/Flare_2_resized_and_flipped_1000x355_PNG.png?v=1777381144"
          }
        },
        "slide_3": {
          "type": "fibrenet-slide",
          "settings": {
            "heading": "Guaranteed compatibility for all network vendors",
            "subheading": "We constantly research and provide the latest vendor coding",
            "image_url_fallback": "https://cdn.shopify.com/s/files/1/0907/5464/6391/files/Flare_3_resized_1000x355_JPG.jpg?v=1777381162"
          }
        },
        "slide_4": {
          "type": "fibrenet-slide",
          "settings": {
            "heading": "Minimum 5 year warranty on all Fibrenet products",
            "subheading": "with advance replacement as standard",
            "image_url_fallback": "https://cdn.shopify.com/s/files/1/0907/5464/6391/files/Flare_4_resized_1000x355_JPG.jpg?v=1777381165"
          }
        }
      },
      "block_order": ["slide_1", "slide_2", "slide_3", "slide_4"]
    }
  ]
}
{% endschema %}
