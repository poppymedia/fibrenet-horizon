{% liquid
  assign is_knowledge_centre = false
  if section.settings.layout_style == 'knowledge_centre'
    assign is_knowledge_centre = true
  endif

  assign articles_per_page = section.settings.articles_per_page
  if articles_per_page == blank or articles_per_page < 1
    if is_knowledge_centre
      assign articles_per_page = 9
    else
      assign articles_per_page = 12
    endif
  endif
%}

{% unless is_knowledge_centre %}
  <script
    src="{{ 'blog-posts-list.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endunless %}

{% unless is_knowledge_centre %}
  <blog-posts-list section-id="{{ section.id }}">
{% endunless %}

{%- if is_knowledge_centre and section.settings.show_tag_filters -%}
  {% render 'blog-tag-filter', blog: blog, show_all_tab: section.settings.show_all_tab %}
{%- endif -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    {% if is_knowledge_centre %}section--page-width blog-posts--knowledge-centre{% endif %}
    color-{{ section.settings.color_scheme }}
    blog-posts
    spacing-style
    size-style
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {% content_for 'blocks' %}

  {%- paginate blog.articles by articles_per_page -%}
    {%- unless is_knowledge_centre -%}
      <span ref="viewMorePrevious"></span>
    {%- endunless -%}

    <div
      {% if is_knowledge_centre %}
        class="blog-posts-container blog-posts-container--grid"
      {% else %}
        ref="grid"
        class="blog-posts-container"
        data-last-page="{{ paginate.pages }}"
      {% endif %}
    >
      {% for article in blog.articles %}
        <div
          class="blog-post-item{% if is_knowledge_centre %} blog-post-item--knowledge-centre{% endif %}"
          {% unless is_knowledge_centre %}
            ref="cards[]"
            data-page="{{ paginate.current_page }}"
          {% endunless %}
        >
          {% content_for 'block', id: 'static-blog-post-card', type: '_blog-post-card', article: article %}
        </div>
      {% endfor %}
    </div>

    {%- if is_knowledge_centre and paginate.pages > 1 -%}
      <div class="blog-posts__pagination">
        {% render 'pagination-controls', paginate: paginate %}
      </div>
    {%- endif -%}

    {%- unless is_knowledge_centre -%}
      <span ref="viewMoreNext"></span>
    {%- endunless -%}
  {%- endpaginate -%}
</div>

{% unless is_knowledge_centre %}
  </blog-posts-list>
{% endunless %}

{% stylesheet %}
  .blog-posts:not(.blog-posts--knowledge-centre) {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
    --columns-gap: 36px;
    --rows-gap: 36px;
  }

  .blog-posts:not(.blog-posts--knowledge-centre) .blog-posts-container {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
    width: 100%;
    column-gap: var(--columns-gap);
    row-gap: var(--rows-gap);
  }

  .blog-posts:not(.blog-posts--knowledge-centre) .blog-post-item {
    --blog-post-card-scale: 0.6;

    grid-column: span 2;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    padding: 0 1rem 1rem;

    @media screen and (max-width: 749px) {
      --blog-post-card-scale: 0.5;

      grid-column: span 6;
    }
  }

  .blog-posts:not(.blog-posts--knowledge-centre) .blog-post-item:nth-child(2),
  .blog-posts:not(.blog-posts--knowledge-centre) .blog-post-item:nth-child(3) {
    --blog-post-card-scale: 0.8;

    grid-column: span 3;

    @media screen and (max-width: 749px) {
      --blog-post-card-scale: 0.5;

      grid-column: span 6;
    }
  }

  .blog-posts:not(.blog-posts--knowledge-centre) .blog-post-item:first-child {
    --blog-post-card-scale: 1;

    grid-column: span 6;
  }

  .blog-posts:not(.blog-posts--knowledge-centre) .blog-post-item:has(.blog-post-card__image-container) {
    border: none;
    padding: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout",
      "options": [
        {
          "value": "editorial",
          "label": "Editorial (default)"
        },
        {
          "value": "knowledge_centre",
          "label": "Knowledge Centre grid"
        }
      ],
      "default": "editorial"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_tag_filters",
      "label": "Show tag filter tabs",
      "default": false,
      "visible_if": "{{ section.settings.layout_style == 'knowledge_centre' }}"
    },
    {
      "type": "checkbox",
      "id": "show_all_tab",
      "label": "Show “All” tab",
      "default": false,
      "visible_if": "{{ section.settings.layout_style == 'knowledge_centre' and section.settings.show_tag_filters }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
